{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"outDir": "dist",
		// Typecheck-only knob: the extension is bundled by esbuild (see build:ext),
		// never emitted by tsc. The program pulls in shared files from ../../source,
		// so the root has to cover the repo, not just plugins/vscode.
		"rootDir": "../..",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "Bundler",
		"resolveJsonModule": true
	},
	"include": [
		"src/**/*",
		"../../source/vscode/cli-path-discovery.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}