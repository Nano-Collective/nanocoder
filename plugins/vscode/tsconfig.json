{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "Bundler",
		"resolveJsonModule": true
	},
	"include": [
		"src/**/*",
		"../../source/vscode/cli-path-discovery.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}