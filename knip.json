{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"scripts/**/*.{js,ts}!",
				"benchmarks/{measure,report}.ts!",
				"benchmarks/agent/{run,harness}.ts!",
				"source/vscode/cli-path-discovery.ts!"
			],
			"project": [
				"**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
				"!source/test-utils/**!",
				"!source/vscode/chat-panel-harness.ts!"
			]
		}
	},
	"ignoreDependencies": ["lint-staged"],
	"ignoreBinaries": [
		"vsce",
		"semgrep",
		"which",
		"gh",
		"osascript",
		"notify-send",
		"powershell",
		"taskkill"
	],
	"ignore": [
		"plugins/**/*",
		".husky/**",
		".github/**",
		"benchmarks/count-loader.mjs",
		"benchmarks/agent/fixtures/**"
	],
	"ignoreExportsUsedInFile": {
		"interface": true,
		"type": true
	},
	"tags": ["-@internal"]
}
