{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreDependencies": ["lint-staged"],
	"ignoreBinaries": [
		"vsce",
		"semgrep",
		"which",
		"gh",
		"osascript",
		"notify-send",
		"powershell",
		"taskkill"
	],
	"ignore": [
		"plugins/**/*",
		".husky/**",
		".github/**",
		"benchmarks/count-loader.mjs",
		"benchmarks/agent/fixtures/**"
	],
	"ignoreExportsUsedInFile": {
		"interface": true,
		"type": true
	},
	"tags": ["-@internal"]
}
